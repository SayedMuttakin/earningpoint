{
  "appId": "com.zenivio.app",
  "appName": "Zenivio",
  "webDir": "dist",
  "server": {
    "url": "https://zenivio.it.com",
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": ["zenivio.it.com"]
  },
  "plugins": {
    "AdMob": {
      "initializeOnAppStart": true
    },
    "GoogleAuth": {
      "scopes": ["profile", "email"],
      "serverClientId": "1028494965258-90o444tljgmd5r6c5si8d8oc2oudnhnl.apps.googleusercontent.com",
      "forceCodeForRefreshToken": true,
      "androidClientId": "1028494965258-9ql287u3is47brl9sj5icnf4l104ke7r.apps.googleusercontent.com"
    },
    "FacebookLogin": {
      "appId": "YOUR_FACEBOOK_APP_ID",
      "appName": "Zenivio"
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#1B0631",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
